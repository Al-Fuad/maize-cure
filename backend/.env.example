CORS_ORIGINS=http://localhost:3000
TORCH_NUM_THREADS=2
MODEL_REPOSITORY=Al-Fuad/maize-cure

# Create a Gemini API key at https://aistudio.google.com/apikey
# Keep this key only in backend/.env or Render environment variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Consensus needs two (or three) configured models. Otherwise rules are used.
# Provider attempts per process/hour, including retries. 0 disables network calls.
AI_MAX_REQUESTS_PER_HOUR=30

# Local rotating JSONL logs: 5 MB + 3 backups, one backend process per log path.
RESEARCH_LOG_ENABLED=1
RESEARCH_LOG_PATH=logs/research.jsonl
# Opt-in only; model output is truncated and known credentials are redacted.
RESEARCH_LOG_RAW=0
